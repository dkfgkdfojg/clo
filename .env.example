# Обязательные ключи (без них некоторые функции не будут работать)
SHODAN_API_KEY=your_shodan_api_key_here
IPINFO_API_KEY=your_ipinfo_api_key_here
EMAILREP_API_KEY=

# Опциональные ключи для дополнительных сервисов
INTELX_API_KEY=
NUMVERIFY_API_KEY=

# Discord: бот-токен из https://discord.com/developers/applications
# Даёт реальные данные через официальный API (username, бейджи, инвайты).
DISCORD_BOT_TOKEN=

# Telegram: api_id/api_hash из https://my.telegram.org (опционально).
# Включают Telethon-тир поверх парсинга t.me. Требует `pip install telethon`.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# GitHub: personal access token (classic, без скоупов хватит).
# Без него лимит 60 запросов/час, с ним — 5000/час.
GITHUB_TOKEN=
